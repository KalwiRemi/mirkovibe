{
  "name": "mirkovibe",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/mirkovibe",
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Aplikacja (PHP)",
      "onAutoForward": "openBrowser"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/postgres:1": {
      "version": "16"
    }
  },
  "remoteEnv": {
    "BAZA_HOST": "localhost",
    "BAZA_NAZWA": "mirkovibe",
    "BAZA_UZYTKOWNIK": "mirkovibe",
    "BAZA_HASLO": "mirkovibe"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },
  "initializeCommand": "test -f .env || cp .env.example .env",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "pkill -f 'php -S 0.0.0.0:8080' 2>/dev/null || true; php -S 0.0.0.0:8080 -t /workspaces/mirkovibe > /tmp/php-server.log 2>&1 &"
}
