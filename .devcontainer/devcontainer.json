{
  "name": "mirkovibe",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Aplikacja (PHP)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },
  "remoteUser": "www-data",
  "initializeCommand": "test -f .env || cp .env.example .env"
}
